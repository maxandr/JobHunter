{
  "manifest_version": 3,
  "name": "Job Hunter form filler",
  "version": "1.2.1",
  "description": "Fills job application forms in your own browser with answers from the local Job Hunter app. Presses Submit only when you use “Try to auto apply”.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Job Hunter form filler", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://localhost/*", "http://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_end" }
  ]
}
